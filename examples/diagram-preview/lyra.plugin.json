{
  "location_provider": null,
  "plugin": {
    "name": "diagram-preview",
    "version": "1.0.0"
  },
  "factory": "preview:create_plugin",
  "nodes": [
    {
      "name": "population_report",
      "description": "Illustrative per-area population share using source areas and aggregate population.",
      "request_schema": {
        "additionalProperties": false,
        "properties": {},
        "title": "population_report_request",
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "spatial_inputs": {},
      "inputs": {
        "areas": {
          "output": "areas",
          "locations": {},
          "parameters": {}
        },
        "totals": {
          "output": "summary",
          "locations": {},
          "parameters": {}
        }
      },
      "outputs": {
        "population_report": {
          "kind": "table",
          "columns": [
            {
              "name": "area_code",
              "dtype": "str",
              "unit": null,
              "description": "Area identifier.",
              "nullable": false
            },
            {
              "name": "population_share",
              "dtype": "float64",
              "unit": "ratio",
              "description": "Share of total population.",
              "nullable": false
            },
            {
              "name": "geometry",
              "dtype": "geometry",
              "description": "Source geometry.",
              "unit": null
            }
          ],
          "geometry": "geometry"
        }
      }
    },
    {
      "name": "population_source",
      "description": "Illustrative source.",
      "request_schema": {
        "additionalProperties": false,
        "properties": {},
        "title": "population_source_request",
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "spatial_inputs": {},
      "inputs": {},
      "outputs": {
        "areas": {
          "kind": "table",
          "columns": [
            {
              "name": "area_code",
              "dtype": "str",
              "unit": null,
              "description": "area_code",
              "nullable": false
            },
            {
              "name": "population",
              "dtype": "int64",
              "unit": "count",
              "description": "population",
              "nullable": false
            },
            {
              "name": "geometry",
              "dtype": "geometry",
              "description": "Source geometry.",
              "unit": null
            }
          ],
          "geometry": "geometry"
        }
      }
    },
    {
      "name": "population_summary",
      "description": "Illustrative summary.",
      "request_schema": {
        "additionalProperties": false,
        "properties": {},
        "title": "population_summary_request",
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "spatial_inputs": {},
      "inputs": {
        "records": {
          "output": "areas",
          "locations": {},
          "parameters": {}
        }
      },
      "outputs": {
        "summary": {
          "kind": "table",
          "columns": [
            {
              "name": "population",
              "dtype": "int64",
              "unit": "count",
              "description": "population",
              "nullable": false
            },
            {
              "name": "density",
              "dtype": "float64",
              "unit": "count/km2",
              "description": "density",
              "nullable": false
            }
          ],
          "geometry": null
        },
        "quality": {
          "kind": "table",
          "columns": [
            {
              "name": "coverage",
              "dtype": "float64",
              "unit": "dimensionless",
              "description": "coverage",
              "nullable": false
            }
          ],
          "geometry": null
        }
      }
    }
  ]
}
