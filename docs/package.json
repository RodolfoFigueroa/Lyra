{
  "name": "lyra-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "uv run --frozen --group dev python -m scripts.generate_docs",
    "predev": "npm run generate",
    "dev": "astro dev",
    "prebuild": "npm run generate",
    "build": "astro build",
    "precheck": "npm run generate",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "uv run --frozen --group dev python -m scripts.check_site --site dist",
    "ci": "npm run test && npm run generate && astro build && astro check --noSync && npm run check:links",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.8",
    "@astrojs/starlight": "^0.41.3",
    "astro": "^7.4.11",
    "starlight-pydocs": "0.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "yaml": "^2.9.0"
  },
  "allowScripts": {}
}
